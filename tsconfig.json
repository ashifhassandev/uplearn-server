{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,

    "esModuleInterop": true,
    "moduleResolution": "node",

    "ignoreDeprecations": "6.0",

    "typeRoots": ["src/@types", "./node_modules/@types"],

    "sourceMap": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"]
}